# Database (use shared jarvis-postgres or standalone)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jarvis_pantry

# GitHub OAuth (for author submissions + command management)
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:7720/submit (or your frontend URL)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin
ADMIN_API_KEY=

# Optional: abuse alerting webhook (Slack/Discord)
ALERT_WEBHOOK_URL=

# Server
PANTRY_PORT=7721

# Validation pipeline
REQUIRE_LLM_KEY=true                   # Set false for dev (skips AI review)
JARVIS_SDK_PATH=/app/jarvis-command-sdk # Path to SDK for container tests
CONTAINER_TEST_TIMEOUT=90              # Seconds before container test is killed
MAX_CONCURRENT_CONTAINER_TESTS=3       # Worker pool size
MAX_CONCURRENT_CLONES=5                # Max parallel git clones
SUBMISSION_RATE_LIMIT_PER_HOUR=10      # Per-IP rate limit for quick-submit
