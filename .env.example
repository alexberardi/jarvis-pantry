# Database (use shared jarvis-postgres or standalone)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jarvis_pantry

# GitHub OAuth (for author submissions)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Household JWT (shared secret with jarvis-notifications for node auth)
STORE_JWT_SECRET=

# Admin
ADMIN_API_KEY=

# Optional: abuse alerting webhook (Slack/Discord)
ALERT_WEBHOOK_URL=

# Server
PANTRY_PORT=7721
