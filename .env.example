# Database (use shared jarvis-postgres or standalone)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jarvis_pantry

# GitHub OAuth (for author submissions + command management)
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:7720/submit (or your frontend URL)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin
ADMIN_API_KEY=

# Optional: abuse alerting webhook (Slack/Discord)
ALERT_WEBHOOK_URL=

# Server
PANTRY_PORT=7721

# Validation pipeline
BYPASS_LLM_KEY=false                   # Set true for dev (skips AI review key requirement)
JARVIS_SDK_PATH=/app/jarvis-command-sdk # Path to SDK for container tests
CONTAINER_TEST_TIMEOUT=90              # Seconds before container test is killed
MAX_CONCURRENT_CONTAINER_TESTS=3       # Worker pool size
MAX_CONCURRENT_CLONES=5                # Max parallel git clones
SUBMISSION_RATE_LIMIT_PER_HOUR=10      # Per-IP rate limit for quick-submit
FORGE_GENERATE_RATE_LIMIT_PER_HOUR=5   # Per-IP rate limit for Forge AI generation
RATE_LIMIT_DISABLED=false              # Set true for dev (bypasses all rate limits)

# Optional: use a model on your own hardware for the Forge (llama-swap, llama.cpp, vLLM, Ollama).
# The server address, key and default model are then set on the web interface's Settings page.
FORGE_LOCAL_LLM_ENABLED=false
# First-run defaults only; the Settings page overrides them.
FORGE_LOCAL_BASE_URL=
FORGE_LOCAL_API_KEY=
FORGE_LOCAL_MODEL=
FORGE_LOCAL_TIMEOUT=900                # Seconds to wait for a local model's reply
FORGE_LOCAL_MAX_TOKENS=8192            # Output cap for local models

# Optional: list a public Pantry's catalogue next to your own packages (blank = your packages only).
PANTRY_UPSTREAM_URL=
PANTRY_UPSTREAM_TTL_SECONDS=300
PANTRY_UPSTREAM_TIMEOUT_SECONDS=8
# Optional: clone token for PRIVATE GitHub repositories when adding a package (needs ADMIN_API_KEY).
PANTRY_GITHUB_TOKEN=
