FROM python:3.11-slim

WORKDIR /app

# Install git (needed for cloning repos during validation)
RUN apt-get update && apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

# Install SDK from GitHub
RUN pip install --no-cache-dir git+https://github.com/alexberardi/jarvis-command-sdk.git@main

# Install dependencies
COPY pyproject.toml .
RUN pip install --no-cache-dir .

# Copy application
COPY app/ app/
COPY alembic/ alembic/
COPY alembic.ini .

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

CMD ["bash", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port ${PANTRY_PORT:-8080}"]
