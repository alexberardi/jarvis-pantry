# Copy to .env.local (ignored by git). Nothing here is a secret by default; set your own values.
PANTRY_DB_PASSWORD=change-me

# Address the BROWSER uses to reach the API. localhost works on the same machine; on a server use its LAN address,
# for example http://10.0.0.20:7721. It is baked into the web build, so rebuild after changing it.
PANTRY_PUBLIC_API_URL=http://localhost:7721

# Optional. Protects the Settings changes and server probes when set (the web interface asks for it).
PANTRY_ADMIN_API_KEY=

# Optional first-run defaults for the Forge's local server; normally set from the Settings page instead.
FORGE_LOCAL_BASE_URL=
FORGE_LOCAL_API_KEY=
FORGE_LOCAL_MODEL=
